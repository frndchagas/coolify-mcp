{
  "mcpServers": {
    "coolify": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/fernandochagas/.local/share/mcp-servers/coolify/dist/server.js"
      ],
      "env": {
        "COOLIFY_BASE_URL": "${COOLIFY_BASE_URL}",
        "COOLIFY_TOKEN": "${COOLIFY_TOKEN}",
        "COOLIFY_ALLOW_WRITE": "true"
      }
    },
    "expo-android": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/fernandochagas/projects/expo-android/dist/server.js"
      ],
      "env": {
        "ADB_SERIAL": "emulator-5556"
      }
    }
  }
}
